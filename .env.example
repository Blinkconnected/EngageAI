# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Backend / API ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:5173

# The externally-visible scheme+host this API is served at (no trailing
# slash) — must match exactly what you configure in each channel
# provider's dashboard. Used to reconstruct exact webhook URLs for
# signature schemes that sign the full URL (e.g. Twilio SMS) — see
# docs/architecture/sms.md. Set to your real public domain in production.
PUBLIC_BASE_URL=http://localhost

# Encrypts secrets-at-rest (e.g. channel provider credentials) — see
# docs/architecture/channels.md. Never reuse JWT_SECRET_KEY for this.
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-different-random-64-char-secret-before-any-real-deployment

# --- PostgreSQL ---
POSTGRES_DB=blinkengage
POSTGRES_USER=blinkengage
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://blinkengage:change-me-postgres-password@postgres:5432/blinkengage

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=blinkengage
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
RABBITMQ_URL=amqp://blinkengage:change-me-rabbitmq-password@rabbitmq:5672/

# --- MinIO / S3-compatible object storage ---
MINIO_ROOT_USER=blinkengage
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=blinkengage
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET_ATTACHMENTS=blinkengage-attachments
S3_USE_SSL=false

# --- AI providers (optional — leave blank to disable a provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT_NAME=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Semantic retrieval (Company Intelligence Engine, stage 1) ---
# Chosen independently of AI_PROVIDER, and normally it must be: Anthropic
# publishes no embedding endpoint, so a company reasoning with Claude has
# to embed somewhere else. "disabled" (the default) keeps the knowledge
# base on its existing keyword search.
#   openai   — hosted; text-embedding-3-small (1536) or -large (truncated)
#   ollama   — self-hosted; the only option where customer text may not
#              leave the network. bge-m3 is multilingual but 1024-wide, so
#              it needs EMBEDDING_DIMENSIONS=1024 and its own migration.
#   hashing  — deterministic, offline, NOT semantic. For tests and for
#              verifying the pipeline before paying for real embeddings.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
# Fall back to OPENAI_API_KEY / OLLAMA_BASE_URL when blank.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# **A schema commitment, not a preference.** The embeddings column is
# created at exactly this width and an HNSW index requires a fixed one, so
# changing it means editing the migration and re-embedding every row.
EMBEDDING_DIMENSIONS=1536
# Chunks per provider request. Every hosted provider charges and
# rate-limits per request, so this is a cost lever, not a tuning detail.
EMBEDDING_BATCH_SIZE=64
# Articles re-indexed per sweep, and how many failures before an article
# stops being retried (it stays visible as failed, with its error).
EMBEDDING_INDEX_BATCH_SIZE=25
EMBEDDING_INDEX_MAX_ATTEMPTS=5
# Candidates pulled from each retriever before fusion. Larger than the
# caller's limit on purpose — fusion can only rank what it is given.
RETRIEVAL_CANDIDATE_POOL=50

# --- Learning Platform (Company Intelligence Engine, stage 3) ---
# Phase 1 is observe-only: no clustering, no detection, no candidates and
# no model calls, so there is nothing here that costs money. Learning is
# switched on per company (Settings -> memory.learning_enabled), not by
# an environment variable.
#
# How long an observation's outcome may still change. A CSAT response
# settles one immediately; this is the wait for the ones nobody rates,
# which is most of them. Far shorter than the 14-day CSAT token life on
# purpose — waiting for the last possible response would make every
# observation two weeks stale, which is the same as not learning.
LEARNING_SETTLE_HOURS=72
# Observations promoted per sweep.
LEARNING_SETTLE_BATCH_SIZE=500
# How often the sweep runs — and the width of the window each run claims,
# which is why it is one setting and not two. A window wider than the
# cadence means most sweeps record nothing, and the failures of the ones
# that recorded nothing never reach the health dashboard.
LEARNING_SETTLE_INTERVAL_SECONDS=900

# --- Phase 2: clustering and pattern detection ---
# Nothing here costs money either: clustering is lexical (no embedding
# provider is involved) and the statistics are arithmetic. What these
# bound is work per sweep, so one large tenant cannot turn a scheduled
# job into an outage.
#
# How often clusters are rebuilt — and the width of the window a cluster
# run claims, which is why it is one setting and not two.
LEARNING_CLUSTER_INTERVAL_SECONDS=3600
LEARNING_CLUSTER_BATCH_SIZE=5000
LEARNING_CLUSTER_COMPANIES_PER_RUN=50
# How far back a sweep looks. Longer than the cadence on purpose: an
# observation that settles late must still be picked up, and re-reading
# an already-clustered one costs one indexed lookup that skips it.
LEARNING_CLUSTER_LOOKBACK_DAYS=14
# Trend windows and their width. Eight weekly windows is long enough for
# two seasonal cycles and short enough that last spring does not define
# what is normal now.
LEARNING_TREND_WINDOWS=8
LEARNING_TREND_WINDOW_DAYS=7
# How often trends and anomalies are recomputed. Daily rather than
# hourly, and that is a statistical decision rather than a cost one:
# testing the same weekly windows twenty-four times a day would be
# multiple testing through the back door, and would defeat the correction
# the detector applies at the front.
LEARNING_ANALYSIS_INTERVAL_SECONDS=86400

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
# Per-user (not per-IP) limit on /ai/* endpoints — every AI Engine call
# has a real external cost. See docs/security/hardening.md.
AI_RATE_LIMIT_PER_MINUTE=20
# Per-user limit on "Test Connection" (POST /channel-configs/test-connection
# and /channel-configs/{id}/test-connection) — each call makes the server
# originate a real outbound connection to an operator-chosen host/port.
CHANNEL_TEST_CONNECTION_RATE_LIMIT_PER_MINUTE=20

# --- Platform/system email (transactional notifications — distinct from
# a company's own customer-facing email channel, see
# docs/architecture/notifications.md) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=notifications@blinkengage.local
SMTP_FROM_NAME=Blink Engage

# --- Mobile push notifications (see docs/architecture/notifications.md) ---
# The service-account JSON key from the Firebase console, on one line and
# verbatim. Leave blank to run without push: mobile apps can still
# register their devices and every notification is still created and
# delivered in-app, nothing is sent, and no notification is marked as
# pushed — so filling this in later starts delivering without a redeploy.
# One transport covers Android and iOS; Firebase relays to APNs itself.
FCM_SERVICE_ACCOUNT_JSON=
# Optional. The key file above already carries project_id; set this only
# for a deployment whose service account sends for a different project.
FCM_PROJECT_ID=
# How old a notification may be and still be worth pushing. Also bounds
# retries: past this, a notification is skipped rather than retried
# forever, which is what stops a backlog — a provider outage, or push
# being switched on for the first time — from firing every stale alert.
PUSH_STALE_AFTER_MINUTES=15

# --- Billing / PayPal (see docs/architecture/billing.md) ---
# The PLATFORM OPERATOR's own merchant account — the one companies pay.
# Deliberately env vars, not database rows: there is exactly one per
# installation, and keeping it out of the database means no API response,
# backup or platform-admin session can expose it.
# Leave blank to run without billing: every endpoint still answers, the
# billing page says it isn't set up, and nothing is charged.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the webhook registered in PayPal's dashboard, pointing at
# https://<your-host>/api/v1/webhooks/paypal. REQUIRED to verify inbound
# webhooks — without it the handler fails closed and processes nothing,
# because acting on an unverified request would let anyone who can reach
# that URL activate a paid subscription for free.
PAYPAL_WEBHOOK_ID=
# Backstop behind PayPal's own dunning retries, not a replacement for
# them: PayPal reports the subscription SUSPENDED once it gives up, and
# that is what normally suspends the company.
BILLING_FAILED_PAYMENTS_BEFORE_SUSPEND=3

# --- Frontend ---
# Relative paths: both the dev NGINX proxy and the production NGINX image
# serve the frontend, API and websocket gateway from a single origin.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1/ws

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password
