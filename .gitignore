# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.sqlite3
backend/.env
backend/alembic/versions/__pycache__/
backend/celerybeat-schedule*
# Docker mount-point artifact, not a real file: docker-compose.yml binds
# the real repo-root CHANGELOG.md onto /app/CHANGELOG.md inside the
# `backend`/celery containers — a nested target under the ./backend:/app
# bind mount — and on first container creation the container runtime
# creates an empty placeholder at this exact host path (the mount's
# underlying inode) before mounting the real file over it in-container.
backend/CHANGELOG.md

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
!docker/**/*.example

# --- Docker / data volumes ---
docker/**/data/
docker/postgres/data/
docker/minio/data/
# The whole directory, not four extensions. `backup_all.sh` writes a
# timestamped *subdirectory* per run (MANIFEST, database.sql.gz,
# minio.tar.gz, secrets.tar.gz.gpg), which the extension patterns below
# do not match — one `git add -A` would have committed a database dump.
backups/
backups/*.sql
backups/*.sql.gz
backups/*.dump
backups/*.tar.gz

# --- IDE / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
monitoring/**/data/

# Visual-verification harness output (screenshots are regenerated on demand)
frontend/.visual-check/*.png
