{
  "title": "Blink Engage — RabbitMQ & Celery",
  "uid": "blinkengage-rabbitmq-celery",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Queue depth (ready messages)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready) by (queue)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Unacked messages",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_unacked) by (queue)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consumers per queue",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_consumers) by (queue)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Celery tasks succeeded vs failed (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(celery_task_succeeded_total[5m])) by (name)",
          "legendFormat": "succeeded: {{name}}"
        },
        {
          "expr": "sum(rate(celery_task_failed_total[5m])) by (name)",
          "legendFormat": "failed: {{name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Celery task runtime p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(celery_task_runtime_bucket[5m])) by (le, name))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
